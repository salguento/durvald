// UniFFI contract for durvald-core.
//
// Types and DurvaldCore methods are defined in Rust via proc-macros (api.rs, core.rs).
// This file references those types for uniffi-bindgen; method exports are discovered
// from the compiled library metadata via #[uniffi::export] on DurvaldCore.

namespace durvald {};

[Rust="object"]
typedef extern DurvaldCore;

[Rust="record"]
typedef extern CoreConfig;

[Rust="record"]
typedef extern Track;

[Rust="record"]
typedef extern TrackPage;

[Rust="record"]
typedef extern PlaybackHistoryItem;

[Rust="record"]
typedef extern PlaybackHistoryPage;

[Rust="record"]
typedef extern Release;

[Rust="record"]
typedef extern ReleasePage;

[Rust="record"]
typedef extern Artist;

[Rust="record"]
typedef extern EnrichmentSettings;

[Rust="enum"]
typedef extern EnrichmentProvider;

[Rust="enum"]
typedef extern ArtistIdentityStatus;

[Rust="enum"]
typedef extern ArtistEntityKind;

[Rust="record"]
typedef extern ArtistPartialDate;

[Rust="record"]
typedef extern EnrichmentAttribution;

[Rust="record"]
typedef extern ArtistProfile;

[Rust="record"]
typedef extern ArtistProfileSource;

[Rust="record"]
typedef extern ArtistImageReference;

[Rust="enum"]
typedef extern ExternalArtworkScope;

[Rust="record"]
typedef extern ExternalReleaseArtwork;

[Rust="record"]
typedef extern ExternalReleaseGroup;

[Rust="record"]
typedef extern ArtistDiscographyPage;

[Rust="enum"]
typedef extern ArtistProfileField;

[Rust="record"]
typedef extern ArtistFieldOverride;

[Rust="record"]
typedef extern ArtistDetails;

[Rust="record"]
typedef extern Playlist;

[Rust="record"]
typedef extern PlaylistTrack;

[Rust="record"]
typedef extern QueueItem;

[Rust="record"]
typedef extern PlaybackSnapshot;

[Rust="enum"]
typedef extern RepeatMode;

[Rust="record"]
typedef extern LastFmStatus;

[Rust="record"]
typedef extern ScanProgress;

[Rust="enum"]
typedef extern ScanPhase;

[Rust="record"]
typedef extern ScanResult;

[Rust="record"]
typedef extern LastSession;

[Rust="record"]
typedef extern Settings;

[Rust="record"]
typedef extern KeyValuePair;

[Rust="record"]
typedef extern AudioMetadata;

[Rust="record"]
typedef extern SearchResults;

[Rust="record"]
typedef extern AuthTokenResponse;

[Rust="record"]
typedef extern SessionResponse;

[Rust="record"]
typedef extern ArtistIdentity;

[Rust="record"]
typedef extern ArtistIdentityCandidate;

[Rust="record"]
typedef extern ArtistIdentityCandidates;

[Rust="enum"]
typedef extern ArtistIdentityOrigin;

[Rust="enum"]
typedef extern ArtistIdentityLookupStatus;

[Rust="enum"]
typedef extern ArtistRefreshSection;

[Rust="record"]
typedef extern ArtistRefreshRequest;

